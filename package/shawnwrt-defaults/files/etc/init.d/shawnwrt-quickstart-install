#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

KIDDIN9_FEED="src/gz kiddin9 https://dl.openwrt.ai/releases/24.10/packages/aarch64_cortex-a53/kiddin9"
DONE_MARK="/etc/shawnwrt-quickstart-installed"

ensure_feed() {
	mkdir -p /etc/opkg
	touch /etc/opkg/customfeeds.conf
	grep -qF "${KIDDIN9_FEED}" /etc/opkg/customfeeds.conf || echo "${KIDDIN9_FEED}" >> /etc/opkg/customfeeds.conf

	# The kiddin9 feed publishes Packages without Packages.sig. Without this,
	# opkg refuses to keep its package list and QuickStart remains unavailable.
	if grep -q '^option check_signature' /etc/opkg.conf 2>/dev/null; then
		cp -a /etc/opkg.conf /etc/opkg.conf.bak.shawnwrt-quickstart 2>/dev/null || true
		sed -i 's/^option check_signature/# option check_signature disabled for kiddin9 unsigned feed/' /etc/opkg.conf
	fi
}

patch_istore_temperature() {
	local backend="/usr/lib/lua/luci/controller/istore_backend.lua"

	[ -f "${backend}" ] || return 0
	grep -q "cpuTemperature" "${backend}" 2>/dev/null && return 0
	cp -a "${backend}" "${backend}.bak.shawnwrt-temp" 2>/dev/null || true

	lua <<'EOF'
local path = "/usr/lib/lua/luci/controller/istore_backend.lua"
local file = assert(io.open(path, "r"))
local data = file:read("*a")
file:close()

local function replace_plain(input, old, new)
	local start_pos, end_pos = input:find(old, 1, true)
	assert(start_pos, "pattern not found")
	return input:sub(1, start_pos - 1) .. new .. input:sub(end_pos + 1)
end

data = replace_plain(data, 'local util = require "luci.util"', 'local util = require "luci.util"\nlocal jsonc = require "luci.jsonc"')

local helper = [[
local function read_cpu_temperature()
  local fs = require "nixio.fs"
  local candidates = {}
  local zones = fs.glob("/sys/class/thermal/thermal_zone*")

  if zones then
    for zone in zones do
      local ttype = fs.readfile(zone .. "/type") or ""
      local temp = fs.readfile(zone .. "/temp")
      if temp then
        local value = tonumber(temp:match("[-0-9]+"))
        if value then
          if value > 1000 then
            value = value / 1000
          end
          if ttype:lower():find("cpu", 1, true) then
            return math.floor(value + 0.5)
          end
          candidates[#candidates + 1] = value
        end
      end
    end
  end

  if #candidates > 0 then
    return math.floor(candidates[1] + 0.5)
  end

  local tempinfo = util.ubus("luci", "getTempInfo", {}) or {}
  if type(tempinfo.tempinfo) == "string" then
    local value = tempinfo.tempinfo:match("CPU:%s*([0-9.]+)")
    if value then
      return math.floor(tonumber(value) + 0.5)
    end
  end

  return nil
end

local function maybe_add_cpu_temperature(body)
  local uri = http.getenv("REQUEST_URI") or ""
  if not uri:match("/istore/system/status/?") then
    return body
  end

  local data = jsonc.parse(body or "")
  if type(data) ~= "table" then
    return body
  end

  data.result = data.result or {}
  if type(data.result) == "table" and data.result.cpuTemperature == nil then
    data.result.cpuTemperature = read_cpu_temperature()
  end

  return jsonc.stringify(data)
end
]]

data = replace_plain(data, "\nlocal function chunksource(sock, buffer)", "\n" .. helper .. "\nlocal function chunksource(sock, buffer)")

local old = [[  local body_buffer = linesrc(true)
  if chunked == 1 then
    ltn12.pump.all(chunksource(sock, body_buffer), http.write)
  else
    local body_source = ltn12.source.cat(ltn12.source.string(body_buffer), sock:blocksource())
    ltn12.pump.all(body_source, http.write)
  end]]

local new = [[  local body_buffer = linesrc(true)
  local body = {}
  local function body_sink(chunk)
    if chunk then
      body[#body + 1] = chunk
    end
    return 1
  end
  if chunked == 1 then
    ltn12.pump.all(chunksource(sock, body_buffer), body_sink)
  else
    local body_source = ltn12.source.cat(ltn12.source.string(body_buffer), sock:blocksource())
    ltn12.pump.all(body_source, body_sink)
  end
  http.write(maybe_add_cpu_temperature(table.concat(body)))]]

data = replace_plain(data, old, new)

local out = assert(io.open(path, "w"))
out:write(data)
out:close()
EOF
}

set_quickstart_home() {
	local quickstart_controller="/usr/lib/lua/luci/controller/quickstart.lua"

	patch_istore_temperature

	if [ -f "${quickstart_controller}" ] && ! grep -q 'template("quickstart/home"), _("主页"), 1' "${quickstart_controller}"; then
		cp -a "${quickstart_controller}" "${quickstart_controller}.bak.shawnwrt-home" 2>/dev/null || true
		sed -i 's/entry({"admin", "quickstart"}, template("quickstart\/home")).leaf = true/entry({"admin", "quickstart"}, template("quickstart\/home"), _("Home"), 1).leaf = true/' "${quickstart_controller}"
		sed -i 's/_("Home")/_("主页")/g' "${quickstart_controller}"
	fi

	if uci -q show luci >/dev/null 2>&1; then
		uci -q get luci.main >/dev/null 2>&1 || uci -q set luci.main='core'
		uci -q set luci.main.default_url='/admin/quickstart'
		uci -q commit luci
	fi

	if [ -d /www ]; then
		cat > /www/index.html <<'EOF'
<!doctype html>
<html>
<head>
<meta http-equiv="refresh" content="0; url=/cgi-bin/luci/admin/quickstart">
</head>
<body>
<a href="/cgi-bin/luci/admin/quickstart">QuickStart</a>
</body>
</html>
EOF
	fi

	rm -rf /tmp/luci-* /tmp/luci-indexcache /tmp/luci-modulecache 2>/dev/null || true
}

start_service() {
	[ -e "${DONE_MARK}" ] && return 0

	if [ ! -x /usr/sbin/quickstart ] || [ ! -f /usr/lib/lua/luci/controller/quickstart.lua ]; then
		ensure_feed
		opkg update >/tmp/shawnwrt-quickstart-opkg.log 2>&1 || return 0
		opkg --force-depends install luci-app-quickstart luci-app-store >>/tmp/shawnwrt-quickstart-opkg.log 2>&1 || return 0
	fi

	/etc/init.d/quickstart enable >/dev/null 2>&1 || true
	/etc/init.d/quickstart start >/dev/null 2>&1 || true
	/etc/init.d/ttyd enable >/dev/null 2>&1 || true

	set_quickstart_home
	touch "${DONE_MARK}"
	/etc/init.d/shawnwrt-quickstart-install disable >/dev/null 2>&1 || true
}
