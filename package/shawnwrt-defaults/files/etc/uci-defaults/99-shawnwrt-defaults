#!/bin/sh

LAN_IP="192.168.10.1"
HOSTNAME="ShawnWrt"
SSID="Everyday is Holiday."
OTA_FEED="src/gz shawnwrt_ota https://raw.githubusercontent.com/ShawnRn/shawnwrt-ota/opkg"
KIDDIN9_FEED="src/gz kiddin9 https://dl.openwrt.ai/releases/24.10/packages/aarch64_cortex-a53/kiddin9"

uci -q batch <<EOF
set system.@system[0].hostname='${HOSTNAME}'
set network.lan.ipaddr='${LAN_IP}'
set dhcp.@dnsmasq[0].domain='lan'
set dhcp.@dnsmasq[0].local='/lan/'
del_list dhcp.@dnsmasq[0].address='/shawnwrt.lan/${LAN_IP}'
add_list dhcp.@dnsmasq[0].address='/shawnwrt.lan/${LAN_IP}'
commit system
commit network
commit dhcp
EOF

if uci -q show wireless >/dev/null 2>&1; then
	for iface in $(uci -q show wireless | sed -n "s/^wireless\\.\\([^.=]*\\)=wifi-iface.*/\\1/p"); do
		mode="$(uci -q get wireless.${iface}.mode)"
		[ "$mode" = "ap" ] || continue
		uci -q set wireless.${iface}.ssid="${SSID}"
		uci -q set wireless.${iface}.disabled='0'
	done
	uci -q commit wireless
fi

if uci -q show nginx >/dev/null 2>&1; then
	uci -q batch <<EOF
delete nginx._redirect2ssl
delete nginx._lan.listen
add_list nginx._lan.listen='80 default_server'
add_list nginx._lan.listen='[::]:80 default_server'
delete nginx._lan.uci_manage_ssl
delete nginx._lan.ssl_certificate
delete nginx._lan.ssl_certificate_key
delete nginx._lan.ssl_session_cache
delete nginx._lan.ssl_session_timeout
commit nginx
EOF
fi

if uci -q show luci >/dev/null 2>&1; then
	uci -q get luci.main >/dev/null 2>&1 || uci -q set luci.main='core'
	uci -q set luci.main.default_url='/cgi-bin/luci/admin/quickstart'
	uci -q commit luci
fi

if [ -d /www ]; then
	cat > /www/index.html <<'EOF'
<!doctype html>
<html>
<head>
<meta http-equiv="refresh" content="0; url=/cgi-bin/luci/admin/quickstart">
</head>
<body>
<a href="/cgi-bin/luci/admin/quickstart">QuickStart</a>
</body>
</html>
EOF
fi

STATUS_MENU="/usr/share/luci/menu.d/luci-mod-status.json"
if [ -f "${STATUS_MENU}" ]; then
	cp -a "${STATUS_MENU}" "${STATUS_MENU}.bak.shawnwrt-mtwifi-channel" 2>/dev/null || true
	# ImmortalWrt's channel analysis view also works on MTK mtwifi, but the
	# stock menu entry is hidden behind a mac80211-only dependency.
	sed -i 's/"acl": \[ "luci-mod-status-channel_analysis" \],/"acl": [ "luci-mod-status-channel_analysis" ]/' "${STATUS_MENU}"
	sed -i '/"uci": { "wireless": { "@wifi-device": { "type": "mac80211" } } }/d' "${STATUS_MENU}"
	awk 'BEGIN{inblk=0} /"admin\/status\/channel_analysis"/{inblk=1} inblk && /"title": "Channel Analysis"/{sub(/"Channel Analysis"/,"\"信道分析\"")} inblk && /},/{inblk=0} {print}' \
		"${STATUS_MENU}" > "${STATUS_MENU}.tmp" && mv "${STATUS_MENU}.tmp" "${STATUS_MENU}"
fi

mkdir -p /etc/opkg
touch /etc/opkg/customfeeds.conf
grep -qF "${OTA_FEED}" /etc/opkg/customfeeds.conf || echo "${OTA_FEED}" >> /etc/opkg/customfeeds.conf
grep -qF "${KIDDIN9_FEED}" /etc/opkg/customfeeds.conf || echo "${KIDDIN9_FEED}" >> /etc/opkg/customfeeds.conf

exit 0
